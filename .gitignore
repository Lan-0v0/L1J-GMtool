# ---- L1J-GMtool ----
# 只放源码、依赖与脚本；运行期产物一律不入库

# ===== GMtool 启动后自动生成 =====
data/*
!data/.gitkeep
*.log
*.lock
*.port

# ===== 编译产物 =====
build/
target/
out/
*.class
*.jar.tmp

# ===== 探测 / 备份 / 临时 =====
tmp-probe/
_bak_*/
*.bak
*.orig
*.rej

# ===== 系统垃圾 =====
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ===== 远端配置与本机密钥 =====
config/sql.properties
keys/
