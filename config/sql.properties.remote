#-------------------------------------------------------------
# SQL config
#-------------------------------------------------------------

# 資料庫連接驅動程式
Driver_LOGIN = com.mysql.jdbc.Driver

# 資料庫位置(登入伺服器)
URL1_LOGIN = jdbc:mysql://127.0.0.1:13306/

# 資料庫名稱(登入伺服器)
URL2_LOGIN = x8

# 連接附加條件(登入伺服器)
URL3_LOGIN = ?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull

# 資料庫 帳戶名稱(登入伺服器)
Login_LOGIN = root

# 資料庫 帳戶密碼(登入伺服器)
Password_LOGIN = root

# 資料庫位置(遊戲伺服器)
URL1 = jdbc:mysql://127.0.0.1:13306/

# 資料庫名稱(遊戲伺服器)
URL2 = x8

# 連接附加條件(遊戲伺服器)
URL3 = ?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull

# 資料庫 帳戶名稱(遊戲伺服器)
Login = root

# 資料庫 帳戶密碼(遊戲伺服器)
Password = root
